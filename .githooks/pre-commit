#!/bin/sh
# Tree Monstor pre-commit gate: docs consistency + skills catalog freshness.
# Enable once per clone:  git config core.hooksPath .githooks
set -e

root="$(git rev-parse --show-toplevel)"

echo "[pre-commit] docs_consistency_check.py"
python3 "$root/scripts/docs_consistency_check.py" || {
  echo "[pre-commit] BLOCKED: docs consistency check failed (see issues above)." >&2
  exit 1
}

echo "[pre-commit] generate_skills_catalog.py --check"
python3 "$root/scripts/generate_skills_catalog.py" --check || {
  echo "[pre-commit] BLOCKED: skills catalog is stale. Run: python3 scripts/generate_skills_catalog.py" >&2
  exit 1
}

echo "[pre-commit] OK"
