# ============================================================
# PM-System 客戶部署 .env template
# Copy 落 <project>/deploy/.env.client.example
# install.sh 會 check `PLACEHOLDER` 字眼仲喺度就 fail
# ============================================================

# ── ⚠️ 必填:發佈版本(同客戶收嘅 tarball 名對應)──
VERSION=v1.0.0

# ── ⚠️ 必填:Database password ──────────────────
# 用強密碼,例: openssl rand -hex 24
DB_PASSWORD=PLACEHOLDER_DB_PASSWORD
# ── Database 帳號/名(可以保留 default)────────
DB_USER=pmuser
DB_NAME=pmdb

# ── ⚠️ 必填:JWT 密鑰 ────────────────────────
# 生成: openssl rand -hex 32
JWT_SECRET=PLACEHOLDER_JWT_SECRET
# ── 可選:Frontend URL(CORS / email link)────
FRONTEND_URL=http://localhost

# ── 可選:Frontend host port(預設 80)────────
# 80 被佔用可以改 8080
FRONTEND_HOST_PORT=80
