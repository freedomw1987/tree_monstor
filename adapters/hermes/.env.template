# Tree Monstor — Hermes Profile Environment Variables
# Copy this to .env and fill in your values

# Required: Discord bot token for Hermes gateway
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Required: OpenRouter API key for model routing
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: MiniMax API key
MINIMAX_API_KEY=your_minimax_key_here

# Optional: Max iterations (default: 1000)
HERMES_MAX_ITERATIONS=1500

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: Gateway port (default: 3000)
# GATEWAY_PORT=3000